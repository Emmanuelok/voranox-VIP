# Voranox Inc. — environment variables
#
# Copy to .env.local for local dev, and set the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Resend API key (https://resend.com) — required to actually deliver
# inquiries from the /contact form. Without this, inquiries are accepted
# and logged to the server console only.
RESEND_API_KEY=

# Where inquiries are delivered.
VORANOX_TO_EMAIL=briefings@voranox.com

# The "From" header. Must be on a domain you've verified in Resend.
# Until your custom domain is verified, you can use Resend's sandbox:
#   onboarding@resend.dev
VORANOX_FROM_EMAIL=Voranox Inc. <onboarding@resend.dev>

# Resend Audience UUID for the Insights newsletter. Without this the
# newsletter form still accepts subscribers (logged server-side) but
# does not enroll them in your audience.
RESEND_AUDIENCE_ID=

# Long random string used to sign Client Portal session and magic-link
# tokens (HMAC-SHA-256). Generate with `openssl rand -base64 32`. In
# production this MUST be set; otherwise tokens are not secure.
PORTAL_SECRET=

# Optional override for the absolute base URL used in magic-link emails.
# Defaults to the request's host. Set this if your custom domain differs.
NEXT_PUBLIC_SITE_URL=https://voranox.com

# Cloudflare Turnstile (optional). When BOTH keys are set, the portal
# login form requires a Turnstile challenge in addition to email +
# rate limit + honeypot. Without these the portal still functions —
# Turnstile is a defence-in-depth layer.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional log drain. When set, every event the firm emits
# (logins, contact submissions, MCP calls, rate limits, etc.) is also
# POSTed as JSON to this URL. Compatible with Slack/Discord webhooks,
# Better Stack / Logtail ingestion, or any custom collector.
LOG_WEBHOOK_URL=
