# Voranox Inc. — environment variables
#
# Copy to .env.local for local dev, and set the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Resend API key (https://resend.com) — required to actually deliver
# inquiries from the /contact form. Without this, inquiries are accepted
# and logged to the server console only.
RESEND_API_KEY=

# Where inquiries are delivered.
VORANOX_TO_EMAIL=briefings@voranox.com

# The "From" header. Must be on a domain you've verified in Resend.
# Until your custom domain is verified, you can use Resend's sandbox:
#   onboarding@resend.dev
VORANOX_FROM_EMAIL=Voranox Inc. <onboarding@resend.dev>
